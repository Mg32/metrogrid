{
  "name": "metrogrid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bots": "node tools/bots/run.ts",
    "replay": "node tools/replay.ts",
    "e2e": "playwright test",
    "shot": "node tools/shot.ts",
    "sound": "node tools/sound.ts",
    "check": "npm run typecheck && npm test && npm run bots && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
